# MPLAD AI Risk & Anomaly Intelligence System - Environment Configuration Example

# Server Environment
ENVIRONMENT=production
DEBUG=false

# Database Configuration (Defaults to high-speed indexed SQLite)
DATABASE_URL=sqlite:///./data/processed/mplads_intelligence.db
# For PostgreSQL Deployment:
# DATABASE_URL=postgresql://user:password@localhost:5432/mplads_db

# API Host and Port
API_HOST=127.0.0.1
API_PORT=8000

# Frontend API URL
VITE_API_URL=http://127.0.0.1:8000/api
